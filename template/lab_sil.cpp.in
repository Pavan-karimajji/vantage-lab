using adas::sil::ComponentManifest;
using lab::LabComponent;

// ---- the helpers the generated header expects its includer to provide -------------------------

const AdasPort* findPort(const AdasPortSet* set, const char* name) {
  if (set == nullptr || set->ports == nullptr) return nullptr;
  for (size_t i = 0; i < set->count; ++i) {
    if (set->ports[i].name != nullptr && std::strcmp(set->ports[i].name, name) == 0) return &set->ports[i];
  }
  return nullptr;
}

AdasPort* findPort(AdasPortSet* set, const char* name) {
  return const_cast<AdasPort*>(findPort(static_cast<const AdasPortSet*>(set), name));
}

/// Takes one input off the port set. An absent or valid=0 input is not offered; bytes that do not
/// parse mark the port malformed, which makes adasExec refuse the run.
template <typename Msg>
void updateReqPort(lab::ReqPort<Msg>& port, const AdasPort* in) {
  port.valid = false;
  port.malformed = false;
  port.ageS = 0.0;
  if (in == nullptr || in->valid == 0 || in->data == nullptr) return;
  if (!port.data.ParseFromArray(in->data, static_cast<int>(in->len))) {
    port.data.Clear();
    port.malformed = true;
    return;
  }
  port.valid = true;
  port.ageS = in->ageS;
}

/// Writes one output into the host's buffer; false when it does not fit.
template <typename Msg>
bool writeAdasProBuf(const Msg& data, bool updated, AdasPort* out) {
  if (out == nullptr) return true;
  out->updated = updated ? 1 : 0;
  if (!updated) return true;
  const size_t size = data.ByteSizeLong();
  if (out->data == nullptr || size > out->cap) return false;
  if (size > 0 && !data.SerializeToArray(out->data, static_cast<int>(size))) return false;
  out->len = size;
  return true;
}

void addFileAndDeps(const google::protobuf::FileDescriptor* file, std::set<std::string>& seen,
                    google::protobuf::FileDescriptorSet& set) {
  if (!seen.insert(file->name()).second) return;
  for (int i = 0; i < file->dependency_count(); ++i) addFileAndDeps(file->dependency(i), seen, set);
  file->CopyTo(set.add_file());
}

}  // namespace

namespace {
#include "${library}_ports.gen.h"
